@model List<TrainingCenterManagement_MVC.ViewModels.AttendanceViewModel>
@{
    ViewData["Title"] = "تسجيل الحضور";
    string lectureTitle = ViewBag.LectureTitle ?? "—";
    DateTime lectureDate = ViewBag.LectureDate ?? DateTime.UtcNow;
    bool isAdmin = ViewBag.IsAdmin == true;
    int presentCount = Model.Count(m => m.IsPresent);
}

<style>
    :root {
        --at-pr:#0d80f2; --at-success:#10b981; --at-danger:#ef4444;
        --at-body:#f1f5f9; --at-card:#fff; --at-t1:#0f172a; --at-t2:#475569; --at-t3:#94a3b8;
        --at-border:#e2e8f0; --at-radius:14px; --at-shadow:0 4px 20px rgba(0,0,0,.07);
    }
    .at-page { background:var(--at-body); direction:rtl; font-family:'Segoe UI',sans-serif; padding:28px 32px; min-height:100vh; }
    .at-header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px; margin-bottom:22px; }
    .at-header h1 { font-size:1.4rem; font-weight:800; color:var(--at-t1); margin:0 0 4px; display:flex; align-items:center; gap:10px; }
    .at-header h1 i { color:var(--at-pr); }
    .at-meta { display:flex; align-items:center; gap:8px; color:var(--at-t2); font-size:.85rem; }
    .at-back { display:inline-flex; align-items:center; gap:6px; color:var(--at-pr); text-decoration:none; font-size:.86rem; font-weight:600; margin-bottom:14px; }
    .at-back:hover { text-decoration:underline; }

    .at-stats { display:flex; gap:14px; margin-bottom:20px; flex-wrap:wrap; }
    .at-stat { background:var(--at-card); border:1px solid var(--at-border); border-radius:12px; box-shadow:var(--at-shadow); padding:14px 20px; min-width:150px; text-align:center; }
    .at-stat .val { font-size:1.5rem; font-weight:800; color:var(--at-t1); }
    .at-stat .lbl { font-size:.76rem; color:var(--at-t3); margin-top:2px; }

    .at-toolbar { display:flex; align-items:center; gap:10px; margin-bottom:16px; }
    .at-bulk-btn { border:1.5px solid var(--at-border); background:#fff; border-radius:8px; padding:7px 14px; font-size:.8rem; font-weight:600; color:var(--at-t2); cursor:pointer; transition:.2s; }
    .at-bulk-btn:hover { background:var(--at-body); }

    .at-table-wrap { background:var(--at-card); border-radius:var(--at-radius); border:1px solid var(--at-border); box-shadow:var(--at-shadow); overflow:hidden; }
    .at-row { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:14px 20px; border-bottom:1px solid #f1f5f9; }
    .at-row:last-child { border-bottom:none; }
    .at-student { display:flex; align-items:center; gap:12px; }
    .at-avatar { width:38px; height:38px; border-radius:50%; background:linear-gradient(135deg,var(--at-pr),#60a5fa); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:.9rem; flex-shrink:0; }
    .at-name { font-weight:600; color:var(--at-t1); font-size:.92rem; }

    .at-toggle { display:flex; border-radius:10px; overflow:hidden; border:1.5px solid var(--at-border); }
    .at-toggle button { border:none; background:#fff; padding:7px 16px; font-size:.82rem; font-weight:700; cursor:pointer; color:var(--at-t2); transition:.15s; display:flex; align-items:center; gap:6px; }
    .at-toggle button.present.active { background:var(--at-success); color:#fff; }
    .at-toggle button.absent.active { background:var(--at-danger); color:#fff; }

    .at-empty { text-align:center; padding:60px 20px; color:var(--at-t3); }
    .at-empty i { font-size:2.5rem; margin-bottom:12px; display:block; }

    .at-submit-bar { display:flex; justify-content:flex-end; margin-top:20px; }
    .at-submit-btn { background:linear-gradient(135deg,var(--at-pr),#3b82f6); color:#fff; border:none; border-radius:10px; padding:12px 30px; font-size:.92rem; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:8px; transition:.2s; }
    .at-submit-btn:hover { opacity:.9; }

    .at-alert { border-radius:10px; padding:12px 18px; font-size:.86rem; font-weight:600; display:flex; align-items:center; gap:10px; margin-bottom:18px; }
    .at-alert-success { background:#dcfce7; color:#166534; border:1.5px solid #86efac; }
    .at-alert-error { background:#fee2e2; color:#991b1b; border:1.5px solid #fca5a5; }
</style>

<div class="dashboard-wrapper" style="display:flex;direction:rtl;min-height:100vh">
@if (isAdmin)
{
    @await Html.PartialAsync("_AdminSidebar")
}
else
{
    @await Html.PartialAsync("_TrainerSidebar")
}
<main class="at-page" style="flex:1;order:2">

    <a asp-action="ViewLecture" asp-route-id="@ViewBag.LectureId" class="at-back">
        <i class="fas fa-arrow-right"></i> العودة للمحاضرة
    </a>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="at-alert at-alert-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="at-alert at-alert-error"><i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]</div>
    }

    <div class="at-header">
        <div>
            <h1><i class="fas fa-clipboard-check"></i> تسجيل الحضور — @lectureTitle</h1>
            <div class="at-meta">
                <i class="fas fa-calendar-alt"></i>
                <span>@lectureDate.ToString("dddd dd MMMM yyyy — hh:mm tt")</span>
            </div>
        </div>
    </div>

    <div class="at-stats">
        <div class="at-stat"><div class="val">@Model.Count</div><div class="lbl">إجمالي الطلاب</div></div>
        <div class="at-stat"><div class="val" style="color:var(--at-success)" id="atPresentCount">@presentCount</div><div class="lbl">حاضر</div></div>
        <div class="at-stat"><div class="val" style="color:var(--at-danger)" id="atAbsentCount">@(Model.Count - presentCount)</div><div class="lbl">غائب</div></div>
    </div>

    @if (!Model.Any())
    {
        <div class="at-table-wrap">
            <div class="at-empty">
                <i class="fas fa-user-slash"></i>
                <p>لا يوجد طلاب مسجّلون في هذه الدورة</p>
            </div>
        </div>
    }
    else
    {
        <form asp-action="MarkAttendance" method="post" id="attendanceForm">
            <input type="hidden" name="lectureId" value="@ViewBag.LectureId" />

            <div class="at-toolbar">
                <button type="button" class="at-bulk-btn" onclick="atSetAll(true)"><i class="fas fa-check-double"></i> تحديد الكل حاضر</button>
                <button type="button" class="at-bulk-btn" onclick="atSetAll(false)"><i class="fas fa-times"></i> تحديد الكل غائب</button>
            </div>

            <div class="at-table-wrap">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var initials = Model[i].FullName.Length > 0 ? Model[i].FullName[0].ToString() : "؟";
                    <div class="at-row">
                        <div class="at-student">
                            <div class="at-avatar">@initials</div>
                            <div class="at-name">@Model[i].FullName</div>
                        </div>
                        <div>
                            <input type="hidden" asp-for="@Model[i].TraineeId" />
                            <input type="hidden" asp-for="@Model[i].FullName" />
                            <input type="hidden" asp-for="@Model[i].IsPresent" class="at-hidden-input" />
                            <div class="at-toggle" data-index="@i">
                                <button type="button" class="present @(Model[i].IsPresent ? "active" : "")" onclick="atToggle(this, @i, true)">
                                    <i class="fas fa-check"></i> حاضر
                                </button>
                                <button type="button" class="absent @(!Model[i].IsPresent ? "active" : "")" onclick="atToggle(this, @i, false)">
                                    <i class="fas fa-times"></i> غائب
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="at-submit-bar">
                <button type="submit" class="at-submit-btn">
                    <i class="fas fa-save"></i> حفظ الحضور
                </button>
            </div>
        </form>
    }

</main>
</div>

<script>
    function atUpdateStats() {
        var inputs = document.querySelectorAll('.at-hidden-input');
        var present = 0;
        inputs.forEach(function (inp) { if (inp.value === 'true') present++; });
        document.getElementById('atPresentCount').textContent = present;
        document.getElementById('atAbsentCount').textContent = inputs.length - present;
    }

    function atToggle(btn, index, isPresent) {
        var row = btn.closest('.at-toggle');
        row.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var hidden = row.parentElement.querySelector('.at-hidden-input');
        hidden.value = isPresent ? 'true' : 'false';
        atUpdateStats();
    }

    function atSetAll(isPresent) {
        document.querySelectorAll('.at-toggle').forEach(function (toggle) {
            var presentBtn = toggle.querySelector('.present');
            var absentBtn = toggle.querySelector('.absent');
            toggle.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
            (isPresent ? presentBtn : absentBtn).classList.add('active');
            var hidden = toggle.parentElement.querySelector('.at-hidden-input');
            hidden.value = isPresent ? 'true' : 'false';
        });
        atUpdateStats();
    }
</script>
